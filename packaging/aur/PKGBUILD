# Maintainer: ericpastorm

pkgname=actx-git
_pkgname=actx
pkgver=0.4.0.r0.g0000000
pkgrel=1
pkgdesc="Keep Claude Code, opencode and Codex conversations in sync across machines, by project"
arch=('x86_64' 'aarch64')
url="https://github.com/ericpastorm/actx"
license=('MIT')
depends=('gcc-libs' 'glibc' 'git' 'fzf')
optdepends=('claude-code: sync and convert Claude Code conversations'
            'opencode: sync and convert opencode conversations'
            'openai-codex-bin: sync and convert Codex conversations')
makedepends=('cargo' 'git')
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!lto' '!debug')
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  local version
  version=$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -1)
  printf "%s.r%s.g%s" "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "$_pkgname"
  install -Dm755 target/release/actx "$pkgdir/usr/bin/actx"
  local shell
  for shell in bash zsh fish; do
    ACTX_LANG=en target/release/actx completions "$shell" > "completions.$shell"
  done
  install -Dm644 completions.bash "$pkgdir/usr/share/bash-completion/completions/actx"
  install -Dm644 completions.zsh "$pkgdir/usr/share/zsh/site-functions/_actx"
  install -Dm644 completions.fish "$pkgdir/usr/share/fish/vendor_completions.d/actx.fish"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
