# ── git: identifying repos and finding their folder on this machine ─────────


def _git(path: str, *args: str) -> str | None:
    try:
        r = subprocess.run(["git", "-C", path, *args], capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout.strip() if r.returncode == 0 else None


@functools.cache
def git_id(path: str) -> dict | None:
    """A repo's identity: its first commit is the same in every clone and worktree."""
    if not Path(path).is_dir():
        return None
    top = _git(path, "rev-parse", "--show-toplevel")
    if not top:
        return None
    roots = _git(path, "rev-list", "--max-parents=0", "HEAD")
    return {
        "top": top,
        "root": min(roots.split()) if roots else None,
        "branch": _git(path, "rev-parse", "--abbrev-ref", "HEAD"),
        "head": _git(path, "rev-parse", "--short", "HEAD"),
    }


def git_info(path: str) -> dict | None:
    info = git_id(path)
    if not info:
        return None
    unpushed = _git(path, "rev-list", "--count", "@{u}..HEAD")
    return info | {
        "remote": _git(path, "remote", "get-url", "origin"),
        "dirty": bool(_git(path, "status", "--porcelain")),
        "unpushed": int(unpushed) if unpushed and unpushed.isdigit() else 0,
    }


def git_label(g: dict) -> str:
    label = f"{g['branch']} @ {g['head']}"
    if g.get("dirty"):
        label += " · " + tr("uncommitted changes")
    if g.get("unpushed"):
        label += " · " + tr("{n} unpushed commit(s)", n=g["unpushed"])
    return label


@functools.cache
def local_repos() -> list[dict]:
    found = []

    def walk(d: Path, depth: int) -> None:
        try:
            entries = list(os.scandir(d))
        except OSError:
            return
        if any(e.name == ".git" for e in entries):  # a folder, or a file in worktrees
            if info := git_id(str(d)):
                found.append(info)
            return
        if depth == 0:
            return
        for e in entries:
            if e.is_dir(follow_symlinks=False) and not e.name.startswith(".") and e.name not in SKIP_DIRS:
                walk(Path(e.path), depth - 1)

    for root in SCAN_ROOTS:
        walk(root, SCAN_DEPTH)
    return found


def _join_sub(top: str, sub: str) -> str:
    if sub in ("", ".") or sub.startswith(".."):
        return top
    p = Path(top) / sub
    return str(p) if p.is_dir() else top


def _best_repo(matches: list[dict], g: dict) -> dict | None:
    if len(matches) == 1:
        return matches[0]
    for same in (
        lambda m: m["top"] == g["top"],
        lambda m: m["branch"] == g.get("branch"),
        lambda m: Path(m["top"]).name == Path(g["top"]).name,
    ):
        hits = [m for m in matches if same(m)]
        if len(hits) == 1:
            return hits[0]
    return None


def resolve_folder(meta: dict, st: dict) -> str | None:
    """The folder on this machine where a stored conversation goes, or None if it isn't clear."""
    g = meta.get("git") or {}
    same_path = str(HOME / meta["rel"]) if meta.get("rel") is not None else meta["path"]
    if g.get("root"):
        sub = os.path.relpath(meta["path"], g["top"])
        remembered = st["folders"].get(f"git:{g['root']}")
        if remembered and Path(remembered).is_dir():
            here = git_id(remembered)
            return _join_sub(here["top"], sub) if here and here["root"] == g["root"] else remembered
        there = git_id(same_path)
        if there and there["root"] == g["root"]:
            return same_path
        here = git_id(os.getcwd())
        if here and here["root"] == g["root"]:  # you're inside the project (e.g. its terminal in your IDE)
            return _join_sub(here["top"], sub)
        best = _best_repo([r for r in local_repos() if r["root"] == g["root"]], g)
        if best:
            return _join_sub(best["top"], sub)
        return None
    remembered = st["folders"].get(f"path:{meta['path']}")
    if remembered and Path(remembered).is_dir():
        return remembered
    return same_path if Path(same_path).is_dir() else None


def ask_folder(meta: dict, st: dict) -> str | None:
    if not sys.stdin.isatty():
        return None
    g = meta.get("git") or {}
    name = _norm(Path(g.get("top") or meta["path"]).name)

    def likeness(top: str) -> int:  # 0 = same name, 1 = similar, 2 = unrelated
        other = _norm(Path(top).name)
        return 0 if other == name else 1 if name and (name in other or other in name) else 2

    cwd = os.path.realpath(os.getcwd())
    same_repo = [r["top"] for r in local_repos() if g.get("root") and r["root"] == g["root"]]
    others = sorted((r["top"] for r in local_repos()), key=lambda t: (likeness(t), t))
    options = list(dict.fromkeys([cwd, *same_repo, *others, str(HOME)]))
    rows = [(p, (paint("32", tr("● here: ")) if p == cwd else "  ") + short(p), "") for p in options]
    rows.append(("::other", "  " + tr("✎ other folder (type the path)"), ""))
    header = tr("Where does «{title}» go? On {host} it was in {path}",
                title=meta["title"][:60], host=meta["host"], path=short(meta["path"]))
    picked = fzf(rows, header, preview=False)
    if not picked:
        return None
    folder = picked[0]
    if folder == "::other":
        folder = os.path.realpath(os.path.expanduser(ask(tr("Path:"), lower=False)))
        if not Path(folder).is_dir():
            warn(tr("{path} doesn't exist", path=short(folder)))
            return None
    st["folders"][f"git:{g['root']}" if g.get("root") else f"path:{meta['path']}"] = folder
    here = git_id(folder)
    if g.get("root") and here and here["root"] == g["root"]:
        return _join_sub(here["top"], os.path.relpath(meta["path"], g["top"]))
    return folder


def fixer_for(meta: dict, folder: str):
    g = meta.get("git") or {}
    here = git_id(folder)
    if g.get("root") and here and here["root"] == g["root"]:
        pairs = [(g["top"], here["top"])]
    else:
        pairs = [(meta["path"], folder)]
    return path_fixer(pairs + [(meta["home"], str(HOME))])


def check_git(meta: dict, folder: str) -> None:
    there, here = meta.get("git"), git_id(folder)
    if not there or not here or there.get("root") != here.get("root"):
        return
    host = meta["host"]
    if there.get("dirty"):
        warn(tr("When it was pushed, {host} had uncommitted changes: they're not here.", host=host))
    if there.get("unpushed"):
        warn(tr("When it was pushed, {host} had {n} unpushed commit(s).", host=host, n=there["unpushed"]))
    if (there["branch"], there["head"]) != (here["branch"], here["head"]):
        warn(tr(
            "{repo}: {host} was on {b1} @ {h1}, you're on {b2} @ {h2}. Sync git before continuing.",
            repo=short(here["top"]), host=host, b1=there["branch"], h1=there["head"],
            b2=here["branch"], h2=here["head"],
        ))


# ── local state and backups ─────────────────────────────────────────────────


def load_state() -> dict:
    if not STATE_FILE.exists():
        legacy = STATE_DIR.parent / "ctx" / "state.json"  # before the rename (ctx → actx)
        if legacy.exists():
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            shutil.copy2(legacy, STATE_FILE)
    try:
        st = json.loads(STATE_FILE.read_text())
    except (OSError, ValueError):
        st = {}
    st.setdefault("base", {})  # key → [local weight, stored weight] at the last sync
    st.setdefault("folders", {})  # origin repo or path → folder picked on this machine
    return st


def save_state(st: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(st, ensure_ascii=False, indent=1))
    os.replace(tmp, STATE_FILE)


def _backup_dir() -> Path:
    d = BACKUPS / time.strftime("%Y%m%d-%H%M%S")
    d.mkdir(parents=True, exist_ok=True)
    return d


def backup_file(src: Path, name: str) -> None:
    # reflink: on btrfs/xfs the copy is instant and takes no space until something changes
    subprocess.run(["cp", "--reflink=auto", "-p", str(src), str(_backup_dir() / name)], check=True)


def backup_bytes(data: bytes, name: str) -> None:
    (_backup_dir() / name).write_bytes(data)


# ── the shared folder ───────────────────────────────────────────────────────


def copen(path: Path, mode: str):
    if path.suffix == ".zst":
        if not _zstd:
            raise ActxError(tr("{name} is zstd-compressed and this Python ({version}) can't read it (needs 3.14+)",
                               name=path.name, version=sys.version.split()[0]))
        return _zstd.open(path, mode)
    return gzip.open(path, mode)


def store_root(optional: bool = False) -> Path | None:
    setting = os.environ.get("ACTX_ROOT") or CONFIG.get("root")
    if not setting:
        if optional:
            return None
        die(tr("No shared folder configured yet. Run: {cmd}", cmd=bold("actx init")))
    root = Path(setting).expanduser()
    try:
        root.mkdir(exist_ok=True)
    except OSError as e:
        if optional:
            warn(tr("Can't reach the shared folder ({err}): using only what's on this machine", err=e.strerror))
            return None
        die(tr("Can't reach the shared folder ({root}): {err}.", root=root, err=e.strerror) + "\n  "
            + tr("If it's a network share, check that it's mounted (away from home you may need a VPN)."))
    return root


def project_dirs(root: Path) -> list[Path]:
    return [d for d in root.iterdir() if d.is_dir() and not d.name.startswith((".", "_"))]


def find_project(root: Path, name: str) -> Path | None:
    return next((d for d in project_dirs(root) if d.name.lower() == name.lower()), None)


def stored_sessions(root: Path) -> list[Session]:
    out = []
    for m in root.glob("*/*/*/meta.json"):
        parts = m.relative_to(root).parts
        if parts[0].startswith(("_", ".")) or any(p.startswith(".") for p in parts):
            continue  # _bin and half-written uploads
        try:
            meta = json.loads(m.read_text())
            if meta["harness"] not in HARNESS:
                continue  # stored by a newer actx that knows more tools
            rel = meta.get("rel")
            path = str(HOME / rel) if rel is not None else meta["path"]
            out.append(
                Session(meta["harness"], meta["id"], meta["title"], path, meta["updated"], meta["weight"],
                        meta=meta, store_dir=m.parent, project=parts[0])
            )
        except (OSError, ValueError, KeyError):
            continue
    return out


def push_one(root: Path, project: str, s: Session, git: dict | None, st: dict, remote: dict[str, Session]) -> str | None:
    """Store s in the project. If it was in another project, move it and return that project's name."""
    dest = root / project / s.harness / s.id
    tmp = dest.parent / f".tmp-{s.id}-{os.getpid()}"
    old = dest.parent / f".old-{s.id}-{os.getpid()}"
    shutil.rmtree(tmp, ignore_errors=True)
    tmp.mkdir(parents=True)
    try:
        files, updated, weight, preview = HARNESS[s.harness].push(s, tmp)
        meta = {
            "v": 2, "harness": s.harness, "id": s.id, "title": s.title,
            "path": s.path, "rel": rel_home(s.path), "home": str(HOME),
            "host": HOST, "pushed_at": time.time(), "updated": updated, "weight": weight,
            "files": files, "git": git,
        }
        (tmp / "meta.json").write_text(json.dumps(meta, ensure_ascii=False, indent=2))
        (tmp / "preview.txt").write_text(preview)
        if dest.exists():
            dest.rename(old)
        tmp.rename(dest)
        shutil.rmtree(old, ignore_errors=True)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    st["base"][s.key] = [weight if s.harness == "claude" else s.weight, weight]
    prev = remote.get(s.key)
    if prev and prev.project != project:
        remove_stored(prev)
        return prev.project
    return None


def remove_stored(r: Session) -> None:
    shutil.rmtree(r.store_dir)
    try:
        r.store_dir.parent.rmdir()  # the claude/ or opencode/ folder, if it's now empty
    except OSError:
        pass


def install_kind() -> str:
    """How this copy of actx was installed: 'git' checkout, system 'package', or a 'user' file."""
    if (SELF.parent / ".git").exists():
        return "git"
    if str(SELF).startswith(("/usr/", "/opt/")) or not os.access(SELF, os.W_OK):
        return "package"
    return "user"


def sync_self(root: Path) -> None:
    """Leave a copy of actx in the shared folder, to install it on machines without a package."""
    if install_kind() == "package":
        return
    shared = root / "_bin" / "actx"
    try:
        if shared.exists():
            if shared.read_bytes() == SELF.read_bytes():
                return
            if shared.stat().st_mtime > SELF.stat().st_mtime + 2:
                if install_kind() == "user":
                    warn(tr("There's a newer actx in the shared folder: {cmd}", cmd=bold("actx update")))
                return
        shared.parent.mkdir(exist_ok=True)
        shutil.copy2(SELF, shared)
    except OSError:
        pass


# ── pickers (fzf) ───────────────────────────────────────────────────────────


def fzf(rows: list[tuple[str, str, str]], header: str, multi: bool = False, preview: bool = True) -> list[str]:
    """rows = (key, visible line, preview). Returns the chosen keys."""
    if not shutil.which("fzf"):
        die(tr("actx needs fzf (e.g. sudo pacman -S fzf)"))
    cmd = [
        "fzf", "--ansi", "--delimiter=\t", "--with-nth=2..", "--layout=reverse", "--height=90%",
        "--border=rounded", "--header", header, "--header-first",
    ]
    if multi:
        cmd += ["--multi", "--bind", "ctrl-a:select-all"]
    cache = None
    if preview:
        with tempfile.NamedTemporaryFile("w", suffix=".json", prefix="actx-", delete=False) as fh:
            json.dump({key: prev for key, _line, prev in rows}, fh)
        cache = fh.name
        show = f"{shlex.quote(sys.executable)} {shlex.quote(str(SELF))} _show {shlex.quote(cache)} {{1}}"
        cmd += ["--preview", show, "--preview-window", "right,50%,wrap,<60(down,50%,wrap)"]
    try:
        r = subprocess.run(cmd, input="\n".join(f"{k}\t{line}" for k, line, _prev in rows), text=True,
                           stdout=subprocess.PIPE)
    finally:
        if cache:
            os.unlink(cache)
    if r.returncode != 0:
        return []
    return [line.split("\t", 1)[0] for line in r.stdout.splitlines() if line]


def session_preview(s: Session) -> str:
    lines = [bold(s.title), dim(f"{s.harness} · {s.id} · {s.size_label()}")]
    if s.meta:
        lines.append(dim(tr("in {project} · pushed from {host} {ago}",
                            project=s.project, host=s.meta["host"], ago=ago(s.meta["pushed_at"]))))
        lines.append(dim(tr("folder there: {path}", path=short(s.meta["path"]))))
        if g := s.meta.get("git"):
            lines.append(dim(tr("git when pushed: ") + git_label(g)))
        try:
            body = (s.store_dir / "preview.txt").read_text()
        except OSError:
            body = tr("(no preview)")
    else:
        lines.append(dim(tr("{path} · last activity {ago}", path=short(s.path), ago=ago(s.updated))))
        body = render(HARNESS[s.harness].preview(s), s.harness)
    return "\n".join(lines) + "\n" + dim("─" * 40) + "\n\n" + body


def resume_cmd(harness: str, sid: str, folder: str) -> str:
    return HARNESS[harness].resume(sid, folder)


def _norm(s: str) -> str:
    return re.sub(r"[^a-z0-9]", "", s.lower())


def relevance(name: str, s: Session) -> int:
    """How much a conversation looks like it belongs to project `name`: by folder, path or title."""
    n = _norm(name)
    if not n:
        return 0
    if _norm(Path(s.path).name) == n:
        return 3
    if n in _norm(s.path):
        return 2
    return 1 if n in _norm(s.title) else 0


def clip(title: str, width: int = 42) -> str:
    return title if len(title) <= width else title[:width - 1] + "…"


# ── commands ────────────────────────────────────────────────────────────────


def local_index() -> dict[str, Session]:
    return {s.key: s for s in all_local()}


def warn_dirty(folders: set[str]) -> None:
    for folder in sorted(folders):
        g = git_info(folder)
        if g and (g["dirty"] or g["unpushed"]):
            warn(tr("{repo}: {state}. The conversation travels, the code doesn't: commit and push.",
                    repo=short(g["top"]), state=git_label(g)))


NET_FS = {"autofs", "cifs", "smb3", "smbfs", "nfs", "nfs4", "9p", "fuse.sshfs", "fuse.rclone", "fuse.s3fs"}
SYNC_DIRS = ("Sync", "Dropbox", "Nextcloud", "ownCloud", "OneDrive", "pCloudDrive", "MEGA", "SeaDrive")


def _store_candidates() -> tuple[list[str], list[str]]:
    """(folders that already hold actx data, suggested new folders), from network mounts and sync apps."""
    bases = []
    try:
        for line in Path("/proc/mounts").read_text().splitlines():
            parts = line.split()
            if len(parts) >= 3 and parts[2] in NET_FS and not parts[1].startswith(("/proc", "/sys", "/run/user")):
                bases.append(parts[1].replace("\\040", " "))
    except OSError:
        pass
    bases += [str(HOME / d) for d in SYNC_DIRS if (HOME / d).is_dir()]
    bases = list(dict.fromkeys(bases))
    existing = []
    for base in bases:
        try:
            dirs = [Path(base), *(d for d in Path(base).iterdir() if d.is_dir())]
        except OSError:
            continue
        for d in dirs:
            if any((d / marker).exists() for marker in (".actx", "_bin/actx", "_bin/ctx")):
                existing.append(str(d))
    return existing, [str(Path(b) / "actx") for b in bases]


def cmd_init(args) -> None:
    global SPANISH
    if args.lang:
        SPANISH = args.lang == "es"
    folder = args.folder
    if not folder:
        if not sys.stdin.isatty():
            die(tr("Usage: {cmd}", cmd="actx init <folder>"))
        existing, suggested = _store_candidates()
        rows = [(p, f"{short(p)}  {paint('32', tr('✓ already used by actx'))}", "") for p in existing]
        rows += [(p, short(p), "") for p in suggested if p not in existing]
        rows.append(("::other", tr("✎ other folder (type the path)"), ""))
        header = tr("Where should actx keep your conversations? A folder all your machines can reach")
        picked = fzf(rows, header, preview=False)
        if not picked:
            return
        folder = picked[0]
        if folder == "::other":
            folder = ask(tr("Path:"), lower=False)
            if not folder:
                return
    root = Path(os.path.realpath(os.path.expanduser(folder)))
    try:
        root.mkdir(parents=True, exist_ok=True)
        marker = root / ".actx"
        if not marker.exists():
            marker.write_text(json.dumps({"store": 1}) + "\n")
    except OSError as e:
        die(tr("Can't create {path}: {err}", path=root, err=e.strerror))
    cfg = load_config() | {"root": str(root)}
    if args.lang:
        cfg["lang"] = args.lang
    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + "\n")
    ok(tr("Shared folder: {path}", path=bold(str(root))))
    projects = project_dirs(root)
    if projects:
        print(tr("It already has {n} project(s): {names}", n=len(projects), names=", ".join(d.name for d in projects)))
    warn(tr("Conversations include command output and may contain secrets (API keys, tokens). "
            "Keep this folder private."))
    print(tr("Next: {cmd}", cmd=bold("actx sync" if projects else f"actx mk <{tr('project')}>")))


def cmd_mk(args) -> None:
    name = args.project
    if not name:
        g = git_id(os.getcwd())
        default = Path(g["top"] if g else os.getcwd()).name
        name = ask(tr("Project name [{default}]:", default=default), lower=False) or default
    if not re.fullmatch(r"\w[\w.-]*", name):
        die(tr("Invalid name: use letters, numbers, '-', '_' or '.'"))
    root = store_root()
    pdir = find_project(root, name)
    if pdir:
        name = pdir.name
    else:
        (root / name).mkdir()
        ok(tr("Project {name} created", name=bold(name)))
    remote = {s.key: s for s in stored_sessions(root)}
    st = load_state()
    local = all_local()
    if not local:
        die(tr("No Claude Code, opencode or Codex conversations found on this machine"))
    ranked = sorted(local, key=lambda s: (-relevance(name, s), -s.updated))
    rows = []
    for s in ranked:
        r = remote.get(s.key)
        if r and r.project == name:
            tag = badge(status(s, r, st["base"].get(s.key)))
        elif r:
            tag = paint("35", f"{tr('in {project}', project=r.project):<12}"[:12])
        else:
            tag = " " * 12
        star = paint("33", "★") if relevance(name, s) else " "
        details = f"{short(s.path)} · {s.size_label()} · {ago(s.updated)}"
        if s.src and time.time() - s.updated < ACTIVE_SECS:
            details += " · " + tr("open now")
        line = f"{star} {harness_tag(s.harness)} {tag} {clip(s.title):<42}  {dim(details)}"
        rows.append((s.key, line, session_preview(s)))
    header = tr("{name} · ★ = looks like this project · TAB marks several · Enter saves", name=name)
    keys = set(fzf(rows, header, multi=True))
    chosen = [s for s in ranked if s.key in keys]
    if not chosen:
        return
    todo = []
    for s in chosen:
        r = remote.get(s.key)
        if r and r.project == name and status(s, r, st["base"].get(s.key)) in ("pull", "conflict"):
            question = tr("«{title}» has changes in the shared folder (from {host}) that aren't here. Overwrite them?",
                          title=s.title, host=r.meta["host"])
            if not confirm(question):
                continue
        todo.append(s)
    warn_dirty({s.path for s in todo})
    try:
        for s in todo:
            try:
                moved = push_one(root, name, s, git_info(s.path), st, remote)
                note = dim("  " + tr("(moved from {project})", project=moved)) if moved else ""
                ok(f"{harness_tag(s.harness)} {s.title}{note}")
            except ERRORS as e:
                fail(f"{s.title}: {e}")
    finally:
        save_state(st)
    print("\n" + tr("On your other machines: {cmd}", cmd=bold("actx sync")))
    sync_self(root)


def pick_sync_projects(pending: dict[str, list], args) -> list[str]:
    """Which projects to sync: the one you name, all of them (--all, or no terminal), or the ones you pick."""
    if args.project:
        name = next((p for p in pending if p.lower() == args.project.lower()), None)
        if not name:
            ok(tr("{project}: nothing to sync", project=args.project))
            return []
        return [name]
    if args.all or not sys.stdin.isatty():
        return list(pending)
    cwd, here = os.path.realpath(os.getcwd()), git_id(os.getcwd())

    def is_here(project: str) -> bool:
        return any(
            (l and l.path == cwd) or (here and (r.meta.get("git") or {}).get("root") == here["root"])
            for _state, l, r in pending[project]
        )

    order = sorted(pending, key=lambda p: (not is_here(p), -max(r.updated for _s, _l, r in pending[p])))
    width = max(len(p) for p in order)
    rows = []
    for p in order:
        states = [state for state, _l, _r in pending[p]]
        counts = [
            paint(code, f"{label}{n}")
            for label, code, n in (
                ("↑", "33", states.count("push")),
                ("↓", "36", states.count("pull") + states.count("new")),
                ("⚠", "31", states.count("conflict")),
            )
            if n
        ]
        mark = paint("32", "●") if is_here(p) else " "
        listing = "\n".join(f"{badge(state)} {harness_tag(r.harness)} {r.title}" for state, _l, r in pending[p])
        rows.append((p, f"{mark} {p:<{width}}  {'  '.join(counts)}", f"{bold(p)}\n\n{listing}"))
    header = tr("Sync · ● = where you are · TAB marks several · Ctrl-A all · Enter confirms")
    return fzf(rows, header, multi=True)


def cmd_sync(args) -> None:
    root = store_root()
    remote = stored_sessions(root)
    if not remote:
        print(tr("No conversations in the shared folder yet. Start with: {cmd}", cmd=bold(f"actx mk <{tr('project')}>")))
        return
    st = load_state()
    local = local_index()
    pending: dict[str, list] = {}
    in_sync = 0
    for r in sorted(remote, key=lambda r: (r.project, -r.updated)):
        l = local.get(r.key)
        state = status(l, r, st["base"].get(r.key))
        if state == "synced":
            in_sync += 1
            st["base"].setdefault(r.key, [l.weight, r.weight])
        else:
            pending.setdefault(r.project, []).append((state, l, r))
    if not pending:
        save_state(st)
        ok(tr("All in sync ({n} conversations)", n=in_sync))
        return
    chosen = pick_sync_projects(pending, args)
    if not chosen:
        save_state(st)
        return
    up, down, conflicts = [], [], []
    for project in chosen:
        for state, l, r in pending[project]:
            {"push": up, "pull": down, "new": down}.get(state, conflicts).append((l, r))
    skipped = sum(len(v) for p, v in pending.items() if p not in chosen)
    merges = []
    for l, r in conflicts:
        host = r.meta["host"]
        warn(tr("{project} · «{title}» changed here and on {host} since the last sync.",
                project=r.project, title=r.title, host=host))
        print(dim("  " + tr("merge = keep this one + a summary of what was done on {host}; "
                            "{host}'s version is kept separately", host=host)))
        choice = ask("  " + tr("What now? [m]erge / [l]ocal / [r]emote ({host}) / [s]kip:", host=host))[:1]
        if choice == "m":
            merges.append((l, r))
        elif choice in ("l", "a"):  # local / aquí
            up.append((l, r))
        elif choice in ("r", "o"):  # remote / otro
            down.append((l, r))
        else:
            print(dim("  " + tr("skipped")))
    ready = []
    try:
        warn_dirty({l.path for l, _r in up})
        for l, r in up:
            try:
                push_one(root, r.project, l, git_info(l.path), st, {})
                print(f"{paint('33', '↑')} {r.project:<14} {harness_tag(r.harness)} {r.title}")
            except ERRORS as e:
                fail(f"{r.title}: {e}")
        checked = set()
        for l, r in down:
            # if you already have it, it stays where it is; if it's new, find its place
            folder = l.path if l and Path(l.path).is_dir() else resolve_folder(r.meta, st) or ask_folder(r.meta, st)
            if not folder:
                warn(tr("{project} · «{title}»: I don't know which folder it goes in on this machine; skipping",
                        project=r.project, title=r.title))
                continue
            if folder not in checked:
                check_git(r.meta, folder)
                checked.add(folder)
            try:
                weight = HARNESS[r.harness].install(r, l, folder, fixer_for(r.meta, folder))
                st["base"][r.key] = [weight, r.weight]
                print(f"{paint('36', '↓')} {r.project:<14} {harness_tag(r.harness)} {r.title}  {dim('→ ' + short(folder))}")
                ready.append((r, folder))
            except ERRORS as e:
                fail(f"{r.title}: {e}")
        for l, r in merges:
            try:
                merge_one(root, l, r, st)
            except ERRORS as e:
                fail(tr("{title}: couldn't merge ({err}); nothing else was touched", title=r.title, err=e))
    finally:
        save_state(st)
    if in_sync:
        ok(tr("{n} in sync", n=in_sync))
    if skipped:
        print(dim(tr("{n} pending in projects you didn't pick", n=skipped)))
    if ready:
        print("\n" + tr("To continue:"))
        for r, folder in ready:
            print(f"  {resume_cmd(r.harness, r.id, folder)}   {dim(r.title[:50])}")
    sync_self(root)


def cmd_ls(args) -> None:
    root = store_root()
    dirs = project_dirs(root)
    if args.project:
        pdir = find_project(root, args.project)
        if not pdir:
            die(tr("Project {name} doesn't exist. Create it with: {cmd}",
                   name=args.project, cmd=f"actx mk {args.project}"))
        dirs = [pdir]
    if not dirs:
        print(tr("No projects yet. Create one with: {cmd}", cmd=bold(f"actx mk <{tr('project')}>")))
        return
    st = load_state()
    local = local_index()
    by_project: dict[str, list[Session]] = {}
    for r in stored_sessions(root):
        by_project.setdefault(r.project, []).append(r)
    pending = 0
    for d in sorted(dirs, key=lambda d: -max((r.updated for r in by_project.get(d.name, [])), default=0)):
        ss = sorted(by_project.get(d.name, []), key=lambda r: -r.updated)
        print(bold(d.name) + dim("  " + (tr("{n} conversation(s)", n=len(ss)) if ss else tr("(empty)"))))
        for r in ss:
            l = local.get(r.key)
            state = status(l, r, st["base"].get(r.key))
            pending += state != "synced"
            where = short(l.path) if l else tr("{path} on {host}", path=short(r.meta["path"]), host=r.meta["host"])
            print(f"  {badge(state)} {harness_tag(r.harness)} {r.title}  {dim(f'· {where} · {ago(r.updated)}')}")
        print()
    if pending:
        print(tr("There are pending changes: {cmd}", cmd=bold("actx sync")))


def cmd_rm(args) -> None:
    root = store_root()
    pdir = find_project(root, args.project)
    if not pdir:
        die(tr("Project {name} doesn't exist", name=args.project))
    ss = sorted((r for r in stored_sessions(root) if r.project == pdir.name), key=lambda r: -r.updated)
    if not ss:
        if confirm(tr("{name} is empty. Delete it?", name=pdir.name)):
            shutil.rmtree(pdir)
            ok(tr("Project {name} deleted", name=pdir.name))
        return
    rows = [
        (r.key, f"{harness_tag(r.harness)} {time.strftime('%d %b %H:%M', time.localtime(r.updated))}  {r.title}",
         session_preview(r))
        for r in ss
    ]
    header = tr("Remove from {name} (nothing is deleted on your machines) · TAB marks several", name=pdir.name)
    keys = set(fzf(rows, header, multi=True))
    chosen = [r for r in ss if r.key in keys]
    if not chosen:
        return
    everything = len(chosen) == len(ss)
    if everything:
        question = tr("Delete the whole project {name}?", name=pdir.name)
    else:
        question = tr("Remove {n} from {name}?", n=len(chosen), name=pdir.name)
    if not confirm(question):
        return
    st = load_state()
    for r in chosen:
        remove_stored(r)
        st["base"].pop(r.key, None)
    if everything:
        shutil.rmtree(pdir, ignore_errors=True)
    save_state(st)
    ok(tr("Project {name} deleted", name=pdir.name) if everything else tr("Removed {n}", n=len(chosen)))


def pick_target(chosen: list[Session]) -> str | None:
    """The tool to copy the chosen conversations into: asked only if there's more than one option."""
    sources = {s.harness for s in chosen}
    options = [name for name, h in HARNESS.items() if h.installed() and {name} != sources]
    if not options:
        die(tr("There's no other tool to convert to: install Claude Code, opencode or Codex"))
    if len(options) == 1:
        return options[0]
    rows = [(name, f"→ {harness_tag(name)} {HARNESS[name].label}", "") for name in options]
    picked = fzf(rows, tr("Convert to which tool?"), preview=False)
    return picked[0] if picked else None


def cmd_cv(args) -> None:
    root = store_root(optional=True)
    remote = {r.key: r for r in stored_sessions(root)} if root else {}
    local = all_local()
    have = {s.key for s in local}
    candidates = local + [r for key, r in remote.items() if key not in have]
    if args.project:
        name = args.project.lower()
        candidates = [s for s in candidates if s.key in remote and remote[s.key].project.lower() == name]
        if not candidates:
            die(tr("No conversations in project {name}", name=args.project))
    if not candidates:
        die(tr("No Claude Code, opencode or Codex conversations found"))
    candidates.sort(key=lambda s: -s.updated)
    rows = []
    for s in candidates:
        if s.meta:
            where = tr("{path} on {host}", path=short(s.meta["path"]), host=s.meta["host"])
        else:
            where = short(s.path)
        details = f"{where} · {s.size_label()} · {ago(s.updated)}"
        if s.key in remote:
            details += " · " + tr("in {project}", project=remote[s.key].project)
        rows.append((s.key, f"{harness_tag(s.harness)} {clip(s.title):<42}  {dim(details)}", session_preview(s)))
    header = tr("Convert · creates a copy in another tool, the original is left untouched · TAB marks several")
    keys = set(fzf(rows, header, multi=True))
    chosen = [s for s in candidates if s.key in keys]
    if not chosen:
        return
    target = pick_target(chosen)
    if not target:
        return
    st = load_state()
    ready = []
    try:
        for s in chosen:
            if s.harness == target:
                print(dim(tr("{title}: it's already a {tool} conversation", title=s.title, tool=HARNESS[target].label)))
                continue
            if s.src and s.weight > 50 << 20:
                print(dim(tr("Reading «{title}» ({size})…", title=s.title, size=s.size_label())))
            try:
                new = convert_one(s, target, st)
            except ERRORS as e:
                fail(f"{s.title}: {e}")
                continue
            note = ""
            if root and s.key in remote:  # the copy travels with its project
                project = remote[s.key].project
                try:
                    push_one(root, project, new, git_info(new.path), st, {})
                    note = dim("  " + tr("(also saved in {project})", project=project))
                except ERRORS as e:
                    note = paint("31", "  " + tr("(couldn't save it in {project}: {err})", project=project, err=e))
            ok(f"{harness_tag(s.harness)} → {harness_tag(new.harness)} {new.title}{note}")
            ready.append(new)
    finally:
        save_state(st)
    if ready:
        print("\n" + tr("To continue:"))
        for new in ready:
            print(f"  {resume_cmd(new.harness, new.id, new.path)}")
    if root and ready:
        sync_self(root)


def cmd_update(args) -> None:
    kind = install_kind()
    if kind == "package":
        print(tr("actx was installed with your package manager: update it there (e.g. {cmd}).", cmd="yay -Syu"))
        return
    if kind == "git":
        print(tr("This is a git checkout: update it with {cmd}.", cmd=f"git -C {shlex.quote(str(SELF.parent))} pull"))
        return
    root = store_root()
    shared = root / "_bin" / "actx"
    if not shared.exists():
        sync_self(root)
        ok(tr("There was no actx in the shared folder: uploaded this machine's copy"))
        return
    new = shared.read_bytes()
    if new == SELF.read_bytes():
        ok(tr("You already have the latest version"))
        return
    if SELF.stat().st_mtime > shared.stat().st_mtime + 2:
        shutil.copy2(SELF, shared)
        ok(tr("This machine's version is newer than the shared one: uploaded it"))
        return
    try:
        compile(new, str(shared), "exec")
    except SyntaxError as e:
        die(tr("The shared copy is broken ({err}); not installing it", err=e))
    when = shared.stat().st_mtime
    tmp = SELF.with_name(f".{SELF.name}.new")
    try:
        tmp.write_bytes(new)
        os.chmod(tmp, 0o755)
        os.utime(tmp, (when, when))  # same date as the shared copy, so it doesn't look "newer" than it
        os.replace(tmp, SELF)
    except OSError as e:
        tmp.unlink(missing_ok=True)
        die(tr("Can't write {path}: {err}", path=SELF, err=e.strerror))
    ok(tr("actx updated from the shared folder (saved {ago})", ago=ago(when)))


