    "remove conversations from a project": "quitar conversaciones de un proyecto",
    "copy a conversation into another tool": "copiar una conversación a otro programa",
    "only this project's": "solo las de este proyecto",
    "install the newest actx from the shared folder": "instalar la última versión de actx de la carpeta compartida",
    "show the version": "ver la versión",
}


def main() -> None:
    if len(sys.argv) == 4 and sys.argv[1] == "_show":  # fzf preview
        try:
            print(json.loads(Path(sys.argv[2]).read_text()).get(sys.argv[3], ""))
        except (OSError, ValueError):
            pass
        return
    ap = argparse.ArgumentParser(prog="actx", description=tr(HELP), formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-V", "--version", action="version", version=f"actx {__version__}", help=tr("show the version"))
    sub = ap.add_subparsers(dest="cmd", metavar="{init,mk,sync,ls,rm,cv,update}")
    sp = sub.add_parser("init", help=tr("choose the shared folder"))
    sp.add_argument("folder", nargs="?", metavar=tr("folder"), help=tr("the shared folder (otherwise a picker shows up)"))
    sp.add_argument("--lang", choices=("en", "es"), help=tr("interface language"))
    sp.set_defaults(fn=cmd_init)
    sp = sub.add_parser("mk", help=tr("create a project / save conversations in it"))
    sp.add_argument("project", nargs="?", metavar=tr("project"))
    sp.set_defaults(fn=cmd_mk)
    sp = sub.add_parser("sync", help=tr("push what you continued here and pull what's new"))
    sp.add_argument("project", nargs="?", metavar=tr("project"), help=tr("only this project (otherwise a picker shows up)"))
    sp.add_argument("-a", "--all", "--todo", dest="all", action="store_true", help=tr("all projects, no questions"))
    sp.set_defaults(fn=cmd_sync)
    sp = sub.add_parser("ls", help=tr("show projects and their state"))
    sp.add_argument("project", nargs="?", metavar=tr("project"))
    sp.set_defaults(fn=cmd_ls)
    sp = sub.add_parser("rm", help=tr("remove conversations from a project"))
    sp.add_argument("project", metavar=tr("project"))
    sp.set_defaults(fn=cmd_rm)
    sp = sub.add_parser("cv", help=tr("copy a conversation into another tool"))
    sp.add_argument("project", nargs="?", metavar=tr("project"), help=tr("only this project's"))
    sp.set_defaults(fn=cmd_cv)
    sub.add_parser("update", help=tr("install the newest actx from the shared folder")).set_defaults(fn=cmd_update)
    args = ap.parse_args()
    if not args.cmd:
        args.fn, args.project = cmd_ls, None
    try:
        args.fn(args)
    except KeyboardInterrupt:
        print("\n" + tr("cancelled"))
        sys.exit(130)
    if not args.cmd:
        project = tr("project")
        print(dim(f"actx mk <{project}> · actx sync · actx ls · actx rm <{project}> · actx cv · actx update · actx -h"))


if __name__ == "__main__":
    main()
