# Everything above, per tool, behind one interface. Adding a tool means filling one of these.


def _shell_path(folder: str) -> str:
    p = short(folder)
    return p if re.fullmatch(r"[\w./~+-]+", p) else shlex.quote(folder)


def _read_stored(r: Session, fix, parse):
    with copen(r.store_dir / r.meta["files"]["session"], "rb") as fi:
        return parse((fix(line) if fix else line) for line in fi)


@dataclass(frozen=True)
class Harness:
    label: str
    installed: object  # () -> bool
    local: object  # () -> list[Session]
    preview: object  # (Session) -> [(role, text)]
    push: object  # (Session, tmp dir) -> (files, updated, weight, preview text)
    install: object  # (stored, local or None, folder, fix) -> weight
    local_turns: object  # (Session) -> (turns, model)
    stored_turns: object  # (stored, fix) -> (turns, model)
    write: object  # (turns, folder, title, model) -> Session
    other_branch: object  # (local, stored, fix) -> turns
    append: object  # (local, text, ack) -> None
    branch_copy: object  # (stored, folder, fix, title) -> Session
    resume: object  # (id, folder) -> shell command


def _oc_local_turns(s: Session):
    exp = json.loads(oc_export(s.id, s.path))
    return oc_turns(exp), _oc_model_label(exp)


def _oc_stored_turns(r: Session, fix):
    exp = json.loads(_stored_export(r, fix))
    return oc_turns(exp), _oc_model_label(exp)


def _file_turns(parse):
    def local_turns(s: Session):
        with open(s.src, "rb") as fi:
            return parse(fi), None
    return local_turns


