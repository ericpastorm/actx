# ── output ──────────────────────────────────────────────────────────────────

NO_COLOR = "NO_COLOR" in os.environ or not sys.stdout.isatty()
HCOLOR = {"claude": "38;5;173", "opencode": "36", "codex": "38;5;75"}


def paint(code: str, s: str) -> str:
    return s if NO_COLOR else f"\033[{code}m{s}\033[0m"


def dim(s: str) -> str:
    return paint("2", s)


def bold(s: str) -> str:
    return paint("1", s)


def harness_tag(h: str) -> str:
    return paint(HCOLOR[h], f"{h:<8}")


def die(msg: str) -> None:
    print(paint("31", "✗ ") + msg, file=sys.stderr)
    sys.exit(1)


def warn(msg: str) -> None:
    print(paint("33", "⚠ ") + msg)


def ok(msg: str) -> None:
    print(paint("32", "✓ ") + msg)


def fail(msg: str) -> None:
    print(paint("31", "✗ ") + msg)


def ask(question: str, lower: bool = True) -> str:
    if not sys.stdin.isatty():
        return ""
    try:
        answer = input(paint("33", "? ") + question + " ").strip()
    except EOFError:
        return ""
    return answer.lower() if lower else answer


def confirm(question: str) -> bool:
    return ask(f"{question} {tr('[y/N]')}") in ("y", "yes", "s", "si", "sí")


def ago(ts: float) -> str:
    d = time.time() - ts
    if d < 90:
        return tr("now")
    if d < 3600:
        return tr("{n} min ago", n=int(d // 60))
    if d < 86400:
        return tr("{n} h ago", n=int(d // 3600))
    if d < 7 * 86400:
        return tr("{n} d ago", n=int(d // 86400))
    return time.strftime("%d %b %Y", time.localtime(ts))


def human(n: float) -> str:
    for unit in ("B", "KB", "MB"):
        if n < 1024:
            return f"{n:.0f}{unit}"
        n /= 1024
    return f"{n:.1f}GB"


# ── paths ───────────────────────────────────────────────────────────────────


def short(path: str) -> str:
    h = str(HOME)
    return "~" + path[len(h):] if path == h or path.startswith(h + "/") else path


def rel_home(path: str) -> str | None:
    try:
        return str(Path(path).relative_to(HOME))  # "." for $HOME itself
    except ValueError:
        return None


def encode_claude(path: str) -> str:
    """How Claude Code names a project's folder in ~/.claude/projects."""
    return re.sub(r"[^a-zA-Z0-9]", "-", path)


def resolve_encoded(name: str) -> str | None:
    """Undo encode_claude by looking at the disk ('-' may come from '/', '-', '_', '.', ' '...)."""

    def walk(base: Path, rest: str) -> str | None:
        if not rest:
            return str(base)
        try:
            entries = sorted(os.listdir(base))
        except OSError:
            return None
        for e in entries:
            enc = "-" + encode_claude(e)
            if rest == enc or rest.startswith(enc + "-"):
                found = walk(base / e, rest[len(enc):])
                if found:
                    return found
        return None

    return walk(Path("/"), name) if name.startswith("-") else None


def path_fixer(pairs: list[tuple[str, str]]):
    """A function that swaps another machine's paths for this one's inside a conversation."""
    subs = [
        (old.encode(), re.compile(re.escape(old.encode()) + rb"(?![\w.-])"), new.encode())
        for old, new in pairs
        if old and new and old != new
    ]
    if not subs:
        return None

    def fix(data: bytes) -> bytes:
        for old, pattern, new in subs:
            if old in data:
                data = pattern.sub(lambda _m: new, data)
        return data

    return fix


# ── sessions ────────────────────────────────────────────────────────────────


@dataclass
class Session:
    harness: str
    id: str
    title: str
    path: str  # folder the conversation was started in
    updated: float  # last activity (epoch)
    weight: int  # to tell whether it changed: bytes (claude, codex) or number of messages (opencode)
    src: Path | None = None  # local claude: the .jsonl
    meta: dict | None = None  # stored ones
    store_dir: Path | None = None
    project: str | None = None

    @property
    def key(self) -> str:
        return f"{self.harness}:{self.id}"

    def size_label(self) -> str:
        return f"{self.weight} msgs" if self.harness == "opencode" else human(self.weight)


def status(local: Session | None, remote: Session | None, base: list | None) -> str:
    """What to do with a conversation. base = [local weight, stored weight] at the last sync."""
    if not remote:
        return "local"
    if not local:
        return "new"
    if base:
        changed_here, changed_there = local.weight != base[0], remote.weight != base[1]
        if changed_here and changed_there:
            return "conflict"
        if changed_here:
            return "push"
        return "pull" if changed_there else "synced"
    if local.weight == remote.weight:
        return "synced"
    return "push" if local.weight > remote.weight else "pull"


def badge(st: str) -> str:
    text, code = {
        "local": ("", "0"),
        "new": (tr("↓ new"), "36"),
        "synced": (tr("✓ synced"), "32"),
        "push": (tr("↑ push"), "33"),
        "pull": (tr("↓ pull"), "33"),
        "conflict": (tr("⚠ conflict"), "31"),
    }[st]
    return paint(code, f"{text:<12}")


def render(msgs: list[tuple[str, str]], agent: str) -> str:
    """Last messages as plain text, for previews. msgs = (role, text)."""
    # from the agent, only the last message of each turn: otherwise it buries your questions
    msgs = [m for i, m in enumerate(msgs) if m[0] == "user" or i + 1 == len(msgs) or msgs[i + 1][0] == "user"]
    if not msgs:
        return tr("(no text messages)")
    out = []
    for role, text in msgs[-N_PREVIEW:]:
        text = text.strip()
        if len(text) > 600:
            text = text[:600].rstrip() + " …"
        out.append(f"▌ {tr('you') if role == 'user' else agent}\n{text}\n")
    return "\n".join(out)


# ── Claude Code ─────────────────────────────────────────────────────────────

CWD_RE = re.compile(rb'"cwd":"((?:[^"\\]|\\.)*)"')


def jsonl(obj: dict) -> str:
    """One line the way Claude Code writes them: compact JSON (what claude_local and _last_entry look for)."""
    return json.dumps(obj, ensure_ascii=False, separators=(",", ":")) + "\n"


def _chunks(f: Path, head: int = 256 << 10, tail: int = 2 << 20) -> tuple[bytes, bytes]:
    """Start and end of a .jsonl: sessions can be close to 1 GB, no need to read them whole."""
    size = f.stat().st_size
    with open(f, "rb") as fh:
        h = fh.read(head)
        if size <= head:
            return h, h
        fh.seek(max(head, size - tail))
        return h, fh.read()


def _lines(buf: bytes):
    for line in buf.split(b"\n"):
        if line:
            try:
                yield json.loads(line)
            except ValueError:
                pass  # line cut by the chunk boundary


def _last_entry(buf: bytes, kind: str) -> dict | None:
    i = buf.rfind(f'"type":"{kind}"'.encode())
    if i < 0:
        return None
    start = buf.rfind(b"\n", 0, i) + 1
    end = buf.find(b"\n", i)
    try:
        return json.loads(buf[start:end if end >= 0 else len(buf)])
    except ValueError:
        return None


def _claude_user_text(e: dict) -> str | None:
    if e.get("type") != "user" or e.get("isMeta") or e.get("isSidechain"):
        return None
    content = (e.get("message") or {}).get("content")
    if isinstance(content, str):
        blocks = [content]
    elif isinstance(content, list):
        blocks = [b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text"]
    else:
        return None
    # leave out system reminders, local command output, etc.
    text = "\n".join(b for b in blocks if not b.lstrip().startswith("<")).strip()
    return text or None


def _claude_assistant_text(e: dict) -> str | None:
    if e.get("type") != "assistant" or e.get("isSidechain"):
        return None
    content = (e.get("message") or {}).get("content")
    if not isinstance(content, list):
        return None
    text = "\n".join(b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text")
    return text.strip() or None


def claude_messages(buf: bytes) -> list[tuple[str, str]]:
    msgs = []
    for e in _lines(buf):
        if text := _claude_user_text(e):
            msgs.append(("user", text))
        elif text := _claude_assistant_text(e):
            msgs.append(("assistant", text))
    return msgs


def _claude_title(head: bytes, tail: bytes) -> str:
    for kind, field in (("custom-title", "customTitle"), ("ai-title", "aiTitle"), ("summary", "summary")):
        for buf in (tail, head):
            e = _last_entry(buf, kind)
            if e and e.get(field):
                return str(e[field])
    for e in _lines(head):
        if text := _claude_user_text(e):
            return text.splitlines()[0][:80]
    return tr("(untitled)")


def _claude_project_path(dirname: str, head: bytes, tail: bytes) -> tuple[str, bool]:
    """The project's real path. True if it comes from a cwd that matches the folder name."""
    for buf in (tail, head):
        for m in CWD_RE.finditer(buf):
            try:
                cwd = json.loads(b'"' + m.group(1) + b'"')
            except ValueError:
                continue
            if encode_claude(cwd) == dirname:
                return cwd, True
    return resolve_encoded(dirname) or dirname.replace("-", "/"), False


def claude_local() -> list[Session]:
    out: list[Session] = []
    if not CLAUDE_PROJECTS.is_dir():
        return out
    for pdir in CLAUDE_PROJECTS.iterdir():
        if not pdir.is_dir():
            continue
        found: list[Session] = []
        path, exact = "", False
        for f in pdir.glob("*.jsonl"):
            try:
                st = f.stat()
                head, tail = _chunks(f)
            except OSError:
                continue
            if b'"type":"assistant"' not in head and b'"type":"assistant"' not in tail:
                continue  # opened and closed without a conversation
            if not exact:
                path, exact = _claude_project_path(pdir.name, head, tail)
            found.append(Session("claude", f.stem, _claude_title(head, tail), "", st.st_mtime, st.st_size, src=f))
        for s in found:
            s.path = path
        out += found
    return out


def push_claude(s: Session, tmp: Path) -> tuple[dict, float, int, str]:
    files = {"session": f"session.jsonl.{COMP}"}
    src = s.src
    updated = src.stat().st_mtime
    with open(src, "rb") as fi, copen(tmp / files["session"], "wb") as fo:
        shutil.copyfileobj(fi, fo, 1 << 20)
        weight = fi.tell()  # if the session is still open, what was actually copied
    extra = src.with_suffix("")  # <id>/ with subagents and tool results
    if extra.is_dir():
        files["extra"] = f"extra.tar.{COMP}"
        with tarfile.open(tmp / files["extra"], f"w:{COMP}") as tar:
            tar.add(extra, arcname=s.id)
    return files, updated, weight, render(claude_messages(_chunks(src)[1]), "claude")


def install_claude(r: Session, local: Session | None, folder: str, fix) -> int:
    meta = r.meta
    tdir = CLAUDE_PROJECTS / encode_claude(folder)
    tdir.mkdir(parents=True, exist_ok=True)
    dest = tdir / f"{r.id}.jsonl"
    if local and local.src:
        backup_file(local.src, f"claude-{r.id}.jsonl")
    tmp = tdir / f".{r.id}.jsonl.actx-tmp"
    try:
        with copen(r.store_dir / meta["files"]["session"], "rb") as fi, open(tmp, "wb") as fo:
            if fix:
                for line in fi:
                    fo.write(fix(line))
            else:
                shutil.copyfileobj(fi, fo, 1 << 20)
        os.chmod(tmp, 0o600)
        os.utime(tmp, (meta["updated"], meta["updated"]))
        os.replace(tmp, dest)
    finally:
        tmp.unlink(missing_ok=True)
    if local and local.src and local.src != dest:
        local.src.unlink(missing_ok=True)  # it lived under another folder; it has a backup
    if extra := meta["files"].get("extra"):
        with tarfile.open(r.store_dir / extra) as tar:
            tar.extractall(tdir, filter="data")
    return dest.stat().st_size


# ── opencode ────────────────────────────────────────────────────────────────
# opencode 1.x and 2.x store sessions differently (tables session/message/part vs session_v2/
# session_message) and export them differently (per message {info, parts} vs flat messages).
# Both are handled; a stored conversation remembers which one it came from.


@functools.cache
def oc_db() -> sqlite3.Connection | None:
    if not OPENCODE_DB.exists():
        return None
    try:
        return sqlite3.connect(f"file:{OPENCODE_DB}?mode=ro", uri=True, timeout=5)
    except sqlite3.Error as e:
        warn(tr("Can't read the opencode database ({err}); skipping opencode", err=e))
        return None


@functools.cache
def oc_version() -> int | None:
    """opencode's major version here (1 or 2): from its database, or its CLI when there's no database yet."""
    con = oc_db()
    if con:
        try:
            tables = {name for (name,) in con.execute("select name from sqlite_master where type = 'table'")}
        except sqlite3.Error:
            tables = set()
        if "session_v2" in tables:
            return 2
        if "session" in tables:
            return 1
    if not shutil.which("opencode"):
        return None
    try:
        res = subprocess.run(["opencode", "session", "--help"], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError):
        return None
    return 2 if "import" in res.stdout + res.stderr else 1


def _oc_query(sql: str, args: tuple = ()) -> list:
    con = oc_db()
    if not con:
        return []
    try:
        return con.execute(sql, args).fetchall()
    except sqlite3.Error as e:
        warn(tr("Can't read the opencode database ({err}); skipping opencode", err=e))
        return []


def opencode_local() -> list[Session]:
    if oc_version() == 2:
        sessions, messages, user = "session_v2", "session_message", "m.type = 'user'"
    else:
        sessions, messages, user = "session", "message", "json_extract(m.data, '$.role') = 'user'"
    rows = _oc_query(
        f"""select s.id, s.title, s.directory, s.time_updated,
                   (select count(*) from {messages} m where m.session_id = s.id),
                   (select count(*) from {messages} m where m.session_id = s.id and {user})
            from {sessions} s
            where s.parent_id is null and s.time_archived is null"""
    )
    return [
        Session("opencode", sid, title or tr("(untitled)"), d, upd / 1000, n)
        for sid, title, d, upd, n, users in rows
        if users
    ]


def oc_children(sid: str) -> list[str]:
    table = "session_v2" if oc_version() == 2 else "session"
    out, todo = [], [sid]
    while todo:
        for (cid,) in _oc_query(f"select id from {table} where parent_id = ?", (todo.pop(),)):
            out.append(cid)
            todo.append(cid)
    return out


def _oc_text(kind: str | None, d: dict) -> str | None:
    """Text of an opencode 2.x message."""
    if kind == "user":
        return (d.get("text") or "").strip() or None
    if kind == "assistant":
        blocks = d.get("content") or []
        text = "\n".join(b.get("text", "") for b in blocks if isinstance(b, dict) and b.get("type") == "text")
        return text.strip() or None
    return None


def _oc1_text(m: dict) -> str:
    """Text of an opencode 1.x message ({info, parts}), without parts opencode added by itself."""
    parts = m.get("parts") or []
    texts = [p.get("text") or "" for p in parts if p.get("type") == "text" and not p.get("synthetic") and not p.get("ignored")]
    return "\n".join(texts).strip()


def _oc_format(exp: dict) -> int:
    msgs = exp.get("messages") or []
    return 1 if msgs and "info" in msgs[0] else 2


def oc_export_messages(exp: dict) -> list[tuple[str, str]]:
    """(role, text) of an export of either version, for previews."""
    if _oc_format(exp) == 1:
        return [(m["info"].get("role"), text) for m in exp.get("messages", []) if (text := _oc1_text(m))]
    return [(m.get("type"), text) for m in exp.get("messages", []) if (text := _oc_text(m.get("type"), m))]


def oc_preview(s: Session) -> list[tuple[str, str]]:
    if oc_version() == 2:
        rows = _oc_query(
            "select type, data from session_message where session_id = ? and type in ('user', 'assistant') "
            "order by seq desc limit ?",
            (s.id, N_PREVIEW * 3),
        )
        return [(kind, text) for kind, data in reversed(rows) if (text := _oc_text(kind, json.loads(data)))]
    rows = _oc_query(
        """select json_extract(m.data, '$.role'),
                  (select group_concat(json_extract(p.data, '$.text'), char(10)) from part p
                   where p.message_id = m.id and json_extract(p.data, '$.type') = 'text'
                     and coalesce(json_extract(p.data, '$.synthetic'), 0) = 0)
           from message m where m.session_id = ? order by m.time_created desc, m.id desc limit ?""",
        (s.id, N_PREVIEW * 3),
    )
    return [(role, text.strip()) for role, text in reversed(rows) if text and text.strip()]


def _oc_cmd(sub: list[str], *rest: str) -> list[str]:
    if not shutil.which("opencode"):
        raise ActxError(tr("opencode is not installed on this machine"))
    return ["opencode", *sub, *OPENCODE_ARGS, *rest]


def oc_export(sid: str, cwd: str) -> bytes:
    sub = ["session", "export"] if oc_version() == 2 else ["export"]
    # to a file, not a pipe: through a pipe opencode cuts its output (~320 KB)
    with tempfile.TemporaryFile() as out:
        r = subprocess.run(_oc_cmd(sub, sid), cwd=cwd if Path(cwd).is_dir() else HOME,
                           stdout=out, stderr=subprocess.PIPE, timeout=300)
        out.seek(0)
        data = out.read()
    try:
        json.loads(data)
    except ValueError:
        err = r.stderr.decode(errors="replace").strip()[-300:]
        raise ActxError(tr("opencode couldn't export {sid}: {err}", sid=sid, err=err)) from None
    return data


def oc_import(data: bytes, folder: str) -> None:
    with tempfile.NamedTemporaryFile("wb", suffix=".json", prefix="actx-", delete=False) as fh:
        fh.write(data)
    if oc_version() == 2:
        cmd = _oc_cmd(["session", "import"], "--directory", folder, fh.name)
    else:
        cmd = _oc_cmd(["import"], fh.name)  # opencode 1.x imports into the folder it runs in
    try:
        res = subprocess.run(cmd, cwd=folder, capture_output=True, timeout=300)
    finally:
        os.unlink(fh.name)
    output = (res.stdout + res.stderr).decode(errors="replace")
    if "Imported session" not in output:
        raise ActxError(tr("opencode didn't accept the conversation: {err}", err=output.strip()[-300:]))


def oc_delete(sid: str, cwd: str) -> None:
    res = subprocess.run(_oc_cmd(["session", "delete"], sid), cwd=cwd if Path(cwd).is_dir() else HOME,
                         capture_output=True, timeout=300)
    if res.returncode != 0:
        err = res.stderr.decode(errors="replace").strip()[-300:]
        raise ActxError(tr("opencode couldn't delete {sid}: {err}", sid=sid, err=err))


@functools.cache
def oc_cli_version() -> str:
    try:
        out = subprocess.run(["opencode", "--version"], capture_output=True, text=True, timeout=60).stdout
        return out.split()[-1].lstrip("v")
    except (OSError, subprocess.SubprocessError, IndexError):
        return "1.0.0"


def _oc_id(prefix: str, ts_ms: int, counter: int = 0, descending: bool = False) -> str:
    """opencode-style ids: 12 hex digits of time (reversed for sessions) + 14 random characters."""
    v = ts_ms * 0x1000 + counter
    if descending:
        v = ~v
    return f"{prefix}_{v & 0xFFFFFFFFFFFF:012x}" + "".join(random.choices(string.ascii_letters + string.digits, k=14))


def _slug(title: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")[:40] or "imported"


def _zero_tokens() -> dict:
    return {"input": 0, "output": 0, "reasoning": 0, "cache": {"read": 0, "write": 0}}


def oc_last_model() -> dict | None:
    """The last model you used in opencode, as {providerID, modelID, variant}: copies continue with it."""
    try:
        if oc_version() == 2:
            rows = _oc_query("select json_extract(data, '$.model') from session_message where type = 'assistant' "
                             "order by time_created desc limit 1")
            m = json.loads(rows[0][0]) if rows and rows[0][0] else None
            return {"providerID": m["providerID"], "modelID": m["id"], "variant": m.get("variant")} if m else None
        rows = _oc_query("select data from message where json_extract(data, '$.role') = 'assistant' "
                         "order by time_created desc limit 1")
        d = json.loads(rows[0][0]) if rows else None
        return {"providerID": d["providerID"], "modelID": d["modelID"], "variant": d.get("variant")} if d else None
    except (KeyError, TypeError, ValueError):
        return None


def _model2(m: dict) -> dict:
    """A model in opencode 2.x's shape."""
    return {"id": m["modelID"], "providerID": m["providerID"], **({"variant": m["variant"]} if m.get("variant") else {})}


def _oc2_message(mid: str, ts: int, who: str, text: str, model: dict) -> dict:
    if who == "user":
        return {"id": mid, "time": {"created": ts}, "text": text, "files": [], "agents": [], "type": "user"}
    return {
        "id": mid, "time": {"created": ts, "streamed": ts, "completed": ts}, "type": "assistant", "agent": "build",
        "model": _model2(model), "content": [{"type": "text", "text": text}], "finish": "stop", "rawFinish": "stop",
        "cost": 0, "tokens": _zero_tokens(),
    }


def _oc1_message(sid: str, mid: str, ts: int, who: str, text: str, model: dict, parent: str, folder: str) -> dict:
    if who == "user":
        info = {"id": mid, "sessionID": sid, "role": "user", "time": {"created": ts}, "agent": "build",
                "model": {"providerID": model["providerID"], "modelID": model["modelID"]}}
    else:
        info = {"id": mid, "sessionID": sid, "role": "assistant", "parentID": parent, "modelID": model["modelID"],
                "providerID": model["providerID"], "mode": "build", "agent": "build",
                "path": {"cwd": folder, "root": folder}, "cost": 0, "tokens": _zero_tokens(),
                "time": {"created": ts, "completed": ts}, "finish": "stop"}
    part = {"id": _oc_id("prt", ts), "sessionID": sid, "messageID": mid, "type": "text", "text": text}
    return {"info": info, "parts": [part]}


def oc_write(turns: list, folder: str, title: str, sid: str | None = None, model: dict | None = None) -> Session:
    """Write turns as an opencode session (in the format of the opencode installed here).
    It continues with the last model you used in opencode, or else `model`."""
    model = oc_last_model() or model
    if not model:
        raise ActxError(tr("I don't know which model you use in opencode: open opencode once and try again"))
    t0, t1 = turns[0][2], turns[-1][2]
    sid = sid or _oc_id("ses", t0, descending=True)
    msgs, parent = [], None
    for n, (who, text, ts) in enumerate(turns, 1):
        mid = _oc_id("msg", ts, n)
        if oc_version() == 2:
            msgs.append(_oc2_message(mid, ts, who, text, model))
        else:
            msgs.append(_oc1_message(sid, mid, ts, who, text, model, parent or mid, folder))
        if who == "user":
            parent = mid
    if oc_version() == 2:
        # projectID is required; import --directory replaces it with that folder's project
        info = {"id": sid, "projectID": "global", "agent": "build", "model": _model2(model), "cost": 0,
                "tokens": _zero_tokens(), "outcome": "succeeded", "time": {"created": t0, "updated": t1},
                "title": title, "location": {"directory": folder}}
    else:
        info = {"id": sid, "slug": _slug(title), "projectID": "global", "directory": folder, "title": title,
                "version": oc_cli_version(), "time": {"created": t0, "updated": t1}}
    oc_import(json.dumps({"info": info, "messages": msgs}, ensure_ascii=False).encode(), folder)
    return Session("opencode", sid, title, folder, t1 / 1000, len(msgs))


def push_opencode(s: Session, tmp: Path) -> tuple[dict, float, int, str]:
    data = oc_export(s.id, s.path)
    files = {"session": f"session.json.{COMP}", "children": [], "format": f"opencode-v{oc_version()}"}
    with copen(tmp / files["session"], "wb") as fo:
        fo.write(data)
    for cid in oc_children(s.id):  # subagents
        name = f"child-{cid}.json.{COMP}"
        with copen(tmp / name, "wb") as fo:
            fo.write(oc_export(cid, s.path))
        files["children"].append(name)
    exp = json.loads(data)
    return files, s.updated, len(exp.get("messages", [])), render(oc_export_messages(exp), "opencode")


def _stored_export(r: Session, fix, name: str | None = None) -> bytes:
    with copen(r.store_dir / (name or r.meta["files"]["session"]), "rb") as fi:
        data = fi.read()
    return fix(data) if fix else data


def install_opencode(r: Session, local: Session | None, folder: str, fix) -> int:
    meta = r.meta
    exports = [_stored_export(r, fix, name) for name in [meta["files"]["session"], *meta["files"].get("children", [])]]
    if local:
        # import doesn't replace an existing session: back up, delete and import
        backup_bytes(oc_export(r.id, local.path), f"opencode-{r.id}.json")
        oc_delete(r.id, local.path)
    stored, here = meta["files"].get("format", "opencode-v2"), f"opencode-v{oc_version()}"
    if stored == here:
        for data in exports:
            oc_import(data, folder)
        return r.weight
    # saved by the other major version of opencode: convert it, keeping its id
    warn(tr("«{title}» comes from opencode {a}.x and here you have opencode {b}.x: converted (tool calls become text)",
            title=r.title, a=stored[-1], b=here[-1]))
    exp = json.loads(exports[0])
    return oc_write(oc_turns(exp), folder, r.title, sid=r.id, model=_oc_export_model(exp)).weight


def _oc_export_model(exp: dict) -> dict | None:
    """The model an export was using, as {providerID, modelID, variant}."""
    try:
        if _oc_format(exp) == 1:
            last = next((m["info"] for m in reversed(exp.get("messages", [])) if m["info"].get("role") == "assistant"), None)
            return {"providerID": last["providerID"], "modelID": last["modelID"], "variant": last.get("variant")} if last else None
        m = (exp.get("info") or {}).get("model")
        return {"providerID": m["providerID"], "modelID": m["id"], "variant": m.get("variant")} if m else None
    except (KeyError, TypeError):
        return None


def _oc_model_label(exp: dict) -> str | None:
    return (_oc_export_model(exp) or {}).get("modelID")


def _oc_msg_id(m: dict) -> str | None:
    return m.get("id") or (m.get("info") or {}).get("id")


def _oc_other_branch(l: Session, r: Session, fix) -> list:
    if r.meta["files"].get("format", "opencode-v2") != f"opencode-v{oc_version()}":
        raise ActxError(tr("can't merge between opencode 1.x and 2.x: pick this one or the other one"))
    mine = {_oc_msg_id(m) for m in json.loads(oc_export(l.id, l.path)).get("messages", [])}
    exp = json.loads(_stored_export(r, fix))
    return oc_turns({"messages": [m for m in exp.get("messages", []) if _oc_msg_id(m) not in mine]})


def _oc_append(l: Session, text: str, ack: str) -> None:
    raw = oc_export(l.id, l.path)
    backup_bytes(raw, f"opencode-{l.id}.json")
    exp = json.loads(raw)
    msgs = exp.setdefault("messages", [])
    now = int(time.time() * 1000)
    if _oc_format(exp) == 1:
        last = next((m["info"] for m in reversed(msgs) if m["info"].get("role") == "assistant"), None)
        model = {"providerID": last["providerID"], "modelID": last["modelID"]} if last else oc_last_model()
    else:
        last = next((m["model"] for m in reversed(msgs) if m.get("type") == "assistant" and m.get("model")), None)
        model = {"providerID": last["providerID"], "modelID": last["id"], "variant": last.get("variant")} if last else oc_last_model()
    if not model:
        raise ActxError(tr("I don't know which model you use in opencode: open opencode once and try again"))
    user_id, reply_id = _oc_id("msg", now, 1), _oc_id("msg", now, 2)
    if _oc_format(exp) == 1:
        msgs.append(_oc1_message(l.id, user_id, now, "user", text, model, user_id, l.path))
        msgs.append(_oc1_message(l.id, reply_id, now, "assistant", ack, model, user_id, l.path))
    else:
        msgs.append(_oc2_message(user_id, now, "user", text, model))
        msgs.append(_oc2_message(reply_id, now, "assistant", ack, model))
    oc_delete(l.id, l.path)
    oc_import(json.dumps(exp, ensure_ascii=False).encode(), l.path)
    l.weight, l.updated = len(msgs), now / 1000


def _oc_branch_copy(r: Session, folder: str, fix, title: str) -> Session:
    """The stored version, whole, as a new session (new ids so it doesn't clash with the original)."""
    exp = json.loads(_stored_export(r, fix))
    info, msgs = exp.setdefault("info", {}), exp.get("messages", [])
    t0 = (info.get("time") or {}).get("created") or int(time.time() * 1000)
    sid = _oc_id("ses", t0, descending=True)
    info.update(id=sid, title=title)
    if _oc_format(exp) == 1:
        info["slug"] = _slug(title)
        ids = {m["info"]["id"]: _oc_id("msg", (m["info"].get("time") or {}).get("created") or t0, n)
               for n, m in enumerate(msgs, 1)}
        for m in msgs:
            m["info"].update(id=ids[m["info"]["id"]], sessionID=sid)
            if m["info"].get("parentID") in ids:
                m["info"]["parentID"] = ids[m["info"]["parentID"]]
            for p in m.get("parts") or []:
                p.update(id=_oc_id("prt", t0), sessionID=sid, messageID=m["info"]["id"])
                if p.get("tail_start_id") in ids:
                    p["tail_start_id"] = ids[p["tail_start_id"]]
    else:
        for n, m in enumerate(msgs, 1):
            m["id"] = _oc_id("msg", (m.get("time") or {}).get("created") or t0, n)
    oc_import(json.dumps(exp, ensure_ascii=False).encode(), folder)
    return Session("opencode", sid, title, folder, time.time(), len(msgs))


# ── Codex ───────────────────────────────────────────────────────────────────
# A session is a "rollout" file, ~/.codex/sessions/YYYY/MM/DD/rollout-<time>-<id>.jsonl, holding what
# the model saw (response_item) and what Codex shows (event_msg); titles live in session_index.jsonl.
# Codex finds rollouts by scanning that folder, so copying the file is enough.

CODEX_ID = re.compile(r"([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\.jsonl$")


def _uuid7() -> str:
    if hasattr(uuid, "uuid7"):  # Python 3.14+
        return str(uuid.uuid7())
    ms, rand = int(time.time() * 1000), random.getrandbits(74)
    value = (ms << 80) | (0x7 << 76) | ((rand >> 62) << 64) | (0b10 << 62) | (rand & ((1 << 62) - 1))
    return str(uuid.UUID(int=value))


def _codex_titles() -> dict[str, str]:
    titles = {}
    try:
        lines = CODEX_INDEX.read_text().splitlines()
    except OSError:
        return titles
    for line in lines:
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if e.get("id") and e.get("thread_name"):
            titles[e["id"]] = e["thread_name"]
    return titles


def _codex_set_title(sid: str, title: str) -> None:
    if _codex_titles().get(sid) == title:
        return
    CODEX_INDEX.parent.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
    with open(CODEX_INDEX, "a") as fo:
        fo.write(jsonl({"id": sid, "thread_name": title, "updated_at": stamp}))


def _codex_text(p: dict, role: str) -> str | None:
    """Text of a response_item message from `role`, leaving out injected context like <environment_context>."""
    if p.get("type") != "message" or p.get("role") != role:
        return None
    kinds = ("input_text", "text") if role == "user" else ("output_text", "text")
    texts = [c.get("text", "") for c in p.get("content") or []
             if isinstance(c, dict) and c.get("type") in kinds and not c.get("text", "").lstrip().startswith("<")]
    return "\n".join(texts).strip() or None


def codex_messages(buf: bytes) -> list[tuple[str, str]]:
    msgs = []
    for e in _lines(buf):
        if e.get("type") == "response_item":
            for role in ("user", "assistant"):
                if text := _codex_text(e.get("payload") or {}, role):
                    msgs.append((role, text))
    return msgs


def _codex_meta(f: Path) -> dict:
    with open(f, "rb") as fh:
        try:
            e = json.loads(fh.readline())
        except ValueError:
            return {}
    return (e.get("payload") or {}) if e.get("type") == "session_meta" else {}


def codex_local() -> list[Session]:
    if not CODEX_SESSIONS.is_dir():
        return []
    titles, out = _codex_titles(), []
    for f in CODEX_SESSIONS.glob("*/*/*/rollout-*.jsonl"):
        m = CODEX_ID.search(f.name)
        if not m:
            continue
        try:
            st, meta, (head, tail) = f.stat(), _codex_meta(f), _chunks(f)
        except OSError:
            continue
        if not meta.get("cwd") or meta.get("thread_source") not in (None, "user"):
            continue  # unreadable, or a subagent's thread
        said = [text for role, text in codex_messages(head) + codex_messages(tail) if role == "user"]
        if not said:
            continue
        title = titles.get(m.group(1)) or said[0].splitlines()[0][:80]
        out.append(Session("codex", m.group(1), title, meta["cwd"], st.st_mtime, st.st_size, src=f))
    return out


@functools.cache
def codex_version() -> str:
    try:
        return subprocess.run(["codex", "--version"], capture_output=True, text=True, timeout=60).stdout.split()[-1]
    except (OSError, subprocess.SubprocessError, IndexError):
        return "0.0.0"


def _iso(ts: int) -> str:
    return datetime.fromtimestamp(ts / 1000, timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def _codex_line(kind: str, payload: dict, ts: int) -> str:
    return jsonl({"timestamp": _iso(ts), "type": kind, "payload": payload})


def _codex_task_end(turn: str, last: str, ts: int) -> str:
    return _codex_line("event_msg", {"type": "task_complete", "turn_id": turn, "last_agent_message": last,
                                     "started_at": ts // 1000, "completed_at": ts // 1000, "duration_ms": 0}, ts)


def _codex_turn_lines(sid: str, turns: list) -> list[str]:
    """Rollout lines for turns: what the model sees (response_item) and what Codex shows (event_msg)."""
    lines, turn, last, ts = [], None, "", 0
    for who, text, ts in turns:
        if who == "user" or turn is None:
            if turn:
                lines.append(_codex_task_end(turn, last, ts))
            turn, last = _uuid7(), ""
            lines.append(_codex_line("event_msg", {"type": "task_started", "turn_id": turn, "started_at": ts // 1000}, ts))
        if who == "user":
            item = {"type": "message", "role": "user", "content": [{"type": "input_text", "text": text}]}
            shown = {"type": "UserMessage", "id": str(uuid.uuid4()),
                     "content": [{"type": "text", "text": text, "text_elements": []}]}
        else:
            item = {"type": "message", "role": "assistant", "content": [{"type": "output_text", "text": text}]}
            shown = {"type": "AgentMessage", "id": str(uuid.uuid4()), "content": [{"type": "Text", "text": text}],
                     "phase": "final_answer"}
            last = text
        lines.append(_codex_line("response_item", item, ts))
        lines.append(_codex_line("event_msg", {"type": "item_completed", "thread_id": sid, "turn_id": turn,
                                               "item": shown, "started_at_ms": ts, "completed_at_ms": ts}, ts))
    if turn:
        lines.append(_codex_task_end(turn, last, ts))
    return lines


def _codex_new_path(sid: str) -> Path:
    now = time.localtime()
    d = CODEX_SESSIONS / time.strftime("%Y/%m/%d", now)
    d.mkdir(parents=True, exist_ok=True)
    return d / f"rollout-{time.strftime('%Y-%m-%dT%H-%M-%S', now)}-{sid}.jsonl"


def codex_write(turns: list, folder: str, title: str) -> Session:
    sid = _uuid7()
    path = _codex_new_path(sid)
    t0 = turns[0][2]
    meta = {"id": sid, "session_id": sid, "timestamp": _iso(t0), "cwd": folder,
            "originator": "codex-tui", "cli_version": codex_version(), "source": "cli", "model_provider": "openai"}
    with open(path, "w") as fo:
        fo.write(_codex_line("session_meta", meta, t0))
        fo.writelines(_codex_turn_lines(sid, turns))
    os.chmod(path, 0o600)
    _codex_set_title(sid, title)
    st = path.stat()
    return Session("codex", sid, title, folder, st.st_mtime, st.st_size, src=path)


def push_codex(s: Session, tmp: Path) -> tuple[dict, float, int, str]:
    src = s.src
    files = {"session": f"rollout.jsonl.{COMP}", "name": src.name, "dir": str(src.parent.relative_to(CODEX_SESSIONS))}
    updated = src.stat().st_mtime
    with open(src, "rb") as fi, copen(tmp / files["session"], "wb") as fo:
        shutil.copyfileobj(fi, fo, 1 << 20)
        weight = fi.tell()
    return files, updated, weight, render(codex_messages(_chunks(src)[1]), "codex")


def install_codex(r: Session, local: Session | None, folder: str, fix) -> int:
    meta = r.meta
    dest = CODEX_SESSIONS / meta["files"]["dir"] / meta["files"]["name"]
    dest.parent.mkdir(parents=True, exist_ok=True)
    if local and local.src:
        backup_file(local.src, f"codex-{r.id}.jsonl")
    tmp = dest.with_name(f".{dest.name}.actx-tmp")
    try:
        with copen(r.store_dir / meta["files"]["session"], "rb") as fi, open(tmp, "wb") as fo:
            if fix:
                for line in fi:
                    fo.write(fix(line))
            else:
                shutil.copyfileobj(fi, fo, 1 << 20)
        os.chmod(tmp, 0o600)
        os.utime(tmp, (meta["updated"], meta["updated"]))
        os.replace(tmp, dest)
    finally:
        tmp.unlink(missing_ok=True)
    if local and local.src and local.src != dest:
        local.src.unlink(missing_ok=True)
    _codex_set_title(r.id, r.title)
    return dest.stat().st_size


def codex_turns(lines) -> list[tuple[str, str, int]]:
    """Turns of a Codex rollout, from the last compaction on."""
    items: list = []
    for raw in lines:
        try:
            e = json.loads(raw)
        except ValueError:
            continue
        ts, p = _iso_ms(e.get("timestamp")), e.get("payload") or {}
        if e.get("type") == "compacted":
            history = p.get("replacement_history")
            if isinstance(history, list):
                items = [(ts, x) for x in history if isinstance(x, dict)]
            else:
                summary = f"{tr('[Summary of the earlier part of the conversation]')}\n{p.get('message') or ''}"
                items = [(ts, {"type": "message", "role": "user", "content": [{"type": "input_text", "text": summary}]})]
        elif e.get("type") == "response_item":
            items.append((ts, p))
    turns, calls = [], {}
    for ts, p in items:
        kind = p.get("type")
        if kind == "message":
            if text := _codex_text(p, "user"):
                _add_turn(turns, "user", text, ts)
            elif text := _codex_text(p, "assistant"):
                _add_turn(turns, "assistant", text, ts)
        elif kind in ("function_call", "custom_tool_call", "local_shell_call"):
            raw_args = p.get("arguments", p.get("input", p.get("action")))
            try:
                args = json.loads(raw_args) if isinstance(raw_args, str) else raw_args
            except ValueError:
                args = {"command": raw_args}
            calls[p.get("call_id")] = _tool_call(p.get("name") or kind, args if args is not None else {})
        elif kind in ("function_call_output", "custom_tool_call_output", "local_shell_call_output"):
            output = p.get("output")
            if isinstance(output, dict):
                output = output.get("content") or output.get("output") or output
            _add_turn(turns, "assistant", _tool_text(calls.get(p.get("call_id"), "‹tool›"), _as_text(output)), ts)
    return turns


def _codex_other_branch(l: Session, r: Session, fix) -> list:
    """Rollouts only grow: what the other one has after the part both share."""
    mine = l.src.read_bytes().splitlines()
    with copen(r.store_dir / r.meta["files"]["session"], "rb") as fi:
        theirs = [fix(x) if fix else x for x in fi.read().splitlines()]
    n = 0
    while n < min(len(mine), len(theirs)) and mine[n] == theirs[n]:
        n += 1
    return codex_turns(theirs[n:])


def _codex_append(l: Session, text: str, ack: str) -> None:
    now = int(time.time() * 1000)
    with open(l.src, "a") as fo:
        fo.writelines(_codex_turn_lines(l.id, [("user", text, now), ("assistant", ack, now)]))
    l.weight, l.updated = l.src.stat().st_size, l.src.stat().st_mtime


def _codex_branch_copy(r: Session, folder: str, fix, title: str) -> Session:
    sid = _uuid7()
    path = _codex_new_path(sid)
    with copen(r.store_dir / r.meta["files"]["session"], "rb") as fi, open(path, "wb") as fo:
        for line in fi:
            fo.write((fix(line) if fix else line).replace(r.id.encode(), sid.encode()))
    os.chmod(path, 0o600)
    _codex_set_title(sid, title)
    st = path.stat()
    return Session("codex", sid, title, folder, st.st_mtime, st.st_size, src=path)


# ── converting between tools ────────────────────────────────────────────────
# Your messages and the replies are kept. Each tool has its own tool names and formats, so tool
# calls become text (what was run and what came out). Internal reasoning is dropped: each model
# signs it its own way and the other one wouldn't accept it.

OUT_MAX = 1500  # characters of each tool output that are kept
CONV_BUDGET = 400_000  # at most this many characters (~100k tokens); the beginning is dropped if needed
COPY_SUFFIX = re.compile(r" \((?:from|de) (?:Claude Code|opencode|Codex)\)$")
IMPORT_NOTE = re.compile(
    r"^\[(?:Conversation imported from|Conversación importada de) [^\]\n]*\]\n?"
    r"(?:\[(?:The first|Se han omitido) [^\]\n]*\]\n?)?\s*"
)


def _as_text(x) -> str:
    if isinstance(x, str):
        return x
    if isinstance(x, list):
        return "\n".join(_as_text(i.get("text", "")) if isinstance(i, dict) else str(i) for i in x)
    if isinstance(x, dict):  # e.g. tool errors
        return str(x.get("message") or x.get("text") or json.dumps(x, ensure_ascii=False))
    return "" if x is None else str(x)


def _tool_call(name: str, args) -> str:
    cmd = args.get("command", args.get("cmd")) if isinstance(args, dict) else None
    if isinstance(cmd, list):
        cmd = " ".join(map(str, cmd))
    call = "$ " + cmd if isinstance(cmd, str) else json.dumps(args, ensure_ascii=False)
    return f"‹{name}› " + (call if len(call) <= 400 else call[:400] + "…")


def _tool_text(call: str, output: str, total: int | None = None) -> str:
    output = output.strip()
    total = total or len(output)
    if total > OUT_MAX:
        output = output[:OUT_MAX] + "\n" + tr("… ({n} more characters)", n=total - OUT_MAX)
    return f"{call}\n{output}" if output else call


def _add_turn(turns: list, who: str, text: str, ts: int) -> None:
    text = text.strip()
    if not text:
        return
    if turns and turns[-1][0] == who:  # consecutive messages from the same side: one turn
        turns[-1] = (who, turns[-1][1] + "\n\n" + text, turns[-1][2])
    else:
        turns.append((who, text, ts))


def _iso_ms(s: str | None) -> int:
    try:
        return int(datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp() * 1000)
    except (AttributeError, ValueError):
        return int(time.time() * 1000)


def claude_turns(lines) -> list[tuple[str, str, int]]:
    """Turns (who, text, ms) of the active branch of a Claude Code conversation.

    parentUuid is followed back from the last message, so /rewind and /compact are respected
    (the chain stops at the compaction, and the summary becomes the first message)."""
    entries, last, loose = {}, None, []
    for raw in lines:
        try:
            e = json.loads(raw)
        except ValueError:
            continue
        if e.get("type") not in ("user", "assistant") and not e.get("uuid"):
            continue  # anything with a uuid is part of the chain (attachments, notices...), even if not converted
        slim = {k: e.get(k) for k in ("parentUuid", "type", "isMeta", "timestamp")}
        content = (e.get("message") or {}).get("content")
        if isinstance(content, str):
            content = [{"type": "text", "text": content}]
        blocks = []
        for b in content if isinstance(content, list) else []:
            kind = b.get("type") if isinstance(b, dict) else None
            if kind == "text":
                blocks.append(("text", b.get("text", "")))
            elif kind == "tool_use":
                blocks.append(("call", b.get("id"), _tool_call(b.get("name", "?"), b.get("input"))))
            elif kind == "tool_result":
                out = _as_text(b.get("content"))
                blocks.append(("result", b.get("tool_use_id"), out[:OUT_MAX], len(out)))
        slim["blocks"] = blocks
        if not e.get("uuid"):  # no chain: file order it is
            loose.append(slim)
            continue
        entries[e["uuid"]] = slim
        if e["type"] in ("user", "assistant") and not e.get("isSidechain"):
            last = e["uuid"]
    chain, seen = [], set()
    while last in entries and last not in seen:
        seen.add(last)
        chain.append(entries[last])
        last = entries[last]["parentUuid"]
    turns, calls = [], {}
    for e in reversed(chain) if chain else loose:
        ts = _iso_ms(e["timestamp"])
        if e["type"] == "assistant":
            for b in e["blocks"]:
                if b[0] == "text":
                    _add_turn(turns, "assistant", b[1], ts)
                elif b[0] == "call":
                    calls[b[1]] = b[2]
        elif e["type"] == "user" and not e.get("isMeta"):
            said = []
            for b in e["blocks"]:
                if b[0] == "result":
                    _add_turn(turns, "assistant", _tool_text(calls.get(b[1], "‹tool›"), b[2], b[3]), ts)
                elif b[0] == "text" and not b[1].lstrip().startswith("<"):  # leave out system reminders
                    said.append(b[1])
            _add_turn(turns, "user", "\n".join(said), ts)
    return turns


def oc_turns(exp: dict) -> list[tuple[str, str, int]]:
    """Turns of an opencode export (either version), from the last compaction on (with its summary)."""
    msgs = exp.get("messages", [])
    now = int(time.time() * 1000)
    header = tr("[Summary of the earlier part of the conversation]")
    turns: list = []
    if _oc_format(exp) == 1:
        start = max((i for i, m in enumerate(msgs) if m["info"].get("summary") is True), default=None)
        if start is not None:
            ts = (msgs[start]["info"].get("time") or {}).get("created") or 0
            _add_turn(turns, "user", f"{header}\n{_oc1_text(msgs[start])}", ts)
            msgs = msgs[start + 1:]
        for m in msgs:
            info = m["info"]
            ts = (info.get("time") or {}).get("created") or now
            who = "user" if info.get("role") == "user" else "assistant"
            for p in m.get("parts") or []:
                if p.get("type") == "text" and not p.get("synthetic") and not p.get("ignored"):
                    _add_turn(turns, who, p.get("text") or "", ts)
                elif p.get("type") == "tool":
                    state = p.get("state") or {}
                    output = state.get("output") or state.get("error") or ""
                    call = _tool_call(p.get("tool", "?"), state.get("input") or {})
                    _add_turn(turns, "assistant", _tool_text(call, _as_text(output)), ts)
        return turns
    start = max((i for i, m in enumerate(msgs) if m.get("type") == "compaction" and m.get("summary")), default=None)
    if start is not None:
        ts = (msgs[start].get("time") or {}).get("created") or 0
        _add_turn(turns, "user", f"{header}\n{msgs[start]['summary']}", ts)
        msgs = msgs[start + 1:]
    for m in msgs:
        ts = (m.get("time") or {}).get("created") or now
        if m.get("type") == "user":
            _add_turn(turns, "user", m.get("text") or "", ts)
        elif m.get("type") == "assistant":
            for part in m.get("content") or []:
                if part.get("type") == "text":
                    _add_turn(turns, "assistant", part.get("text") or "", ts)
                elif part.get("type") == "tool":
                    _add_turn(turns, "assistant", _oc_tool_text(part), ts)
    return turns


def _oc_tool_text(part: dict) -> str:
    state = part.get("state") or {}
    if isinstance(state, str):
        try:
            state = json.loads(state)
        except ValueError:
            state = {}
    output = state.get("output") or state.get("error") or state.get("content")
    return _tool_text(_tool_call(part.get("name", "?"), state.get("input") or {}), _as_text(output))


def _fit(turns: list, source: str, model: str | None) -> list:
    """Drop the beginning if it doesn't fit, and leave a note for the agent at the start."""
    total, keep = 0, len(turns)
    for i in range(len(turns) - 1, -1, -1):
        total += len(turns[i][1])
        if total > CONV_BUDGET:
            break
        keep = i
    if keep == len(turns) and turns:  # the last message alone doesn't fit
        keep = len(turns) - 1
        who, text, ts = turns[keep]
        turns[keep] = (who, text[-CONV_BUDGET:], ts)
    dropped, turns = keep, turns[keep:]
    note = tr(
        "[Conversation imported from {source}{model}. Tool calls appear as text.]",
        source=HARNESS[source].label, model=f" ({model})" if model else "",
    )
    if dropped:
        note += "\n" + tr("[The first {n} messages were left out because they didn't fit.]", n=dropped)
    if turns and turns[0][0] == "user":
        rest = IMPORT_NOTE.sub("", turns[0][1])  # if it was already a copy, only the new note stays
        turns[0] = ("user", note + ("\n\n" + rest if rest else ""), turns[0][2])
    else:
        turns.insert(0, ("user", note, turns[0][2] if turns else int(time.time() * 1000)))
    return turns


@functools.cache
def claude_version() -> str:
    env = {k: v for k, v in os.environ.items() if k != "CLAUDECODE"}
    try:
        out = subprocess.run(["claude", "--version"], capture_output=True, text=True, timeout=30, env=env).stdout
        return out.split()[0]
    except (OSError, subprocess.SubprocessError, IndexError):
        return "2.1.0"


def write_claude(turns: list, folder: str, title: str, model: str | None) -> Session:
    sid = str(uuid.uuid4())
    tdir = CLAUDE_PROJECTS / encode_claude(folder)
    tdir.mkdir(parents=True, exist_ok=True)
    path = tdir / f"{sid}.jsonl"
    parent = None
    with open(path, "w") as fo:
        for n, (who, text, ts) in enumerate(turns):
            if who == "user":
                message = {"role": "user", "content": text}
            else:
                message = {
                    "model": model or "imported", "id": f"msg_actx_{n:05d}", "type": "message", "role": "assistant",
                    "content": [{"type": "text", "text": text}], "stop_reason": "end_turn", "stop_sequence": None,
                    "usage": {"input_tokens": 0, "output_tokens": 0},
                }
            u = str(uuid.uuid4())
            stamp = datetime.fromtimestamp(ts / 1000, timezone.utc).isoformat(timespec="milliseconds")
            fo.write(jsonl({
                "parentUuid": parent, "isSidechain": False, "type": who, "message": message, "uuid": u,
                "timestamp": stamp.replace("+00:00", "Z"), "userType": "external", "entrypoint": "cli",
                "cwd": folder, "sessionId": sid, "version": claude_version(),
            }))
            parent = u
        fo.write(jsonl({"type": "ai-title", "aiTitle": title, "sessionId": sid}))
    os.chmod(path, 0o600)
    st = path.stat()
    return Session("claude", sid, title, folder, st.st_mtime, st.st_size, src=path)


def convert_one(s: Session, target: str, st: dict) -> Session:
    """Create a copy of s in another tool and return it. The original is left untouched."""
    source = HARNESS[s.harness]
    if s.meta:  # only in the shared folder
        folder = resolve_folder(s.meta, st) or ask_folder(s.meta, st)
        if not folder:
            raise ActxError(tr("I don't know which folder it goes in on this machine"))
        turns, model = source.stored_turns(s, fixer_for(s.meta, folder))
    else:
        folder = s.path
        turns, model = source.local_turns(s)
    if not turns:
        raise ActxError(tr("it has no text messages to convert"))
    if not Path(folder).is_dir():
        raise ActxError(tr("{path} doesn't exist on this machine", path=short(folder)))
    turns = _fit(turns, s.harness, model)
    title = tr("{title} (from {source})", title=COPY_SUFFIX.sub("", s.title), source=source.label)
    return HARNESS[target].write(turns, folder, title, model)


# ── merging two versions of a conversation ──────────────────────────────────
# If a conversation was continued on both machines, you keep this one and a summary of what was
# done on the other is appended; the other machine's version is kept separately, whole, as a branch.

MERGE_BUDGET = 100_000  # at most this many characters for the other branch's summary
BRANCH_SUFFIX = re.compile(r" \((?:branch from|rama de) [^)]*\)$")


def _claude_other_branch(l: Session, r: Session, fix) -> list:
    """What was done on the other machine since both versions split."""
    mine = set()
    with open(l.src, "rb") as fi:
        for raw in fi:
            try:
                mine.add(json.loads(raw).get("uuid"))
            except ValueError:
                pass
    theirs = []
    with copen(r.store_dir / r.meta["files"]["session"], "rb") as fi:
        for raw in fi:
            try:
                if json.loads(raw).get("uuid") not in mine:
                    theirs.append(fix(raw) if fix else raw)
            except ValueError:
                pass
    return claude_turns(theirs)  # the chain stops by itself where the shared part begins


def _claude_append(l: Session, text: str, ack: str) -> None:
    leaf, cwd = None, l.path
    for buf in (_chunks(l.src)[1], None):
        for e in _lines(buf if buf is not None else l.src.read_bytes()):
            if e.get("uuid") and e.get("type") in ("user", "assistant") and not e.get("isSidechain"):
                leaf, cwd = e["uuid"], e.get("cwd") or cwd
        if leaf:
            break
    now = datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")
    common = {"isSidechain": False, "userType": "external", "entrypoint": "cli", "cwd": cwd,
              "sessionId": l.id, "version": claude_version(), "timestamp": now}
    u1, u2 = str(uuid.uuid4()), str(uuid.uuid4())
    reply = {"model": "actx", "id": f"msg_actx_{u2[:8]}", "type": "message", "role": "assistant",
             "content": [{"type": "text", "text": ack}], "stop_reason": "end_turn", "stop_sequence": None,
             "usage": {"input_tokens": 0, "output_tokens": 0}}
    with open(l.src, "a") as fo:
        fo.write(jsonl(common | {"parentUuid": leaf, "type": "user", "uuid": u1,
                                 "message": {"role": "user", "content": text}}))
        fo.write(jsonl(common | {"parentUuid": u1, "type": "assistant", "uuid": u2, "message": reply}))
    l.weight, l.updated = l.src.stat().st_size, l.src.stat().st_mtime


def _claude_branch_copy(r: Session, folder: str, fix, title: str) -> Session:
    """The stored version, whole, as a new conversation (new ids so it doesn't clash with the original)."""
    sid, renamed = str(uuid.uuid4()), {}
    tdir = CLAUDE_PROJECTS / encode_claude(folder)
    tdir.mkdir(parents=True, exist_ok=True)
    path = tdir / f"{sid}.jsonl"
    with copen(r.store_dir / r.meta["files"]["session"], "rb") as fi, open(path, "w") as fo:
        for raw in fi:
            try:
                e = json.loads(fix(raw) if fix else raw)
            except ValueError:
                continue
            if e.get("type") in ("ai-title", "custom-title", "summary"):
                continue
            for k in ("uuid", "parentUuid", "logicalParentUuid", "leafUuid"):
                if e.get(k):
                    e[k] = renamed.setdefault(e[k], str(uuid.uuid4()))
            if "sessionId" in e:
                e["sessionId"] = sid
            fo.write(jsonl(e))
        fo.write(jsonl({"type": "ai-title", "aiTitle": title, "sessionId": sid}))
    os.chmod(path, 0o600)
    return Session("claude", sid, title, folder, path.stat().st_mtime, path.stat().st_size, src=path)


def _branch_summary(turns: list, host: str) -> str:
    names = {"user": tr("You"), "assistant": tr("Agent")}
    body = "\n\n".join(f"{names[who]}: {text}" for who, text, _ts in turns)
    if len(body) > MERGE_BUDGET:
        body = "…\n" + body[-MERGE_BUDGET:]
    header = tr("[Meanwhile, this conversation continued on {host}. This is what happened there:]", host=host)
    return f"{header}\n\n{body}"


def merge_one(root: Path, l: Session, r: Session, st: dict) -> None:
    h = HARNESS[l.harness]
    host = r.meta["host"]
    fix = fixer_for(r.meta, l.path)
    turns = h.other_branch(l, r, fix)
    git = git_info(l.path)
    tag = f"{paint('35', '⇄')} {r.project:<14} {harness_tag(r.harness)} {r.title}"
    if not turns:  # nothing really new there: this one wins
        push_one(root, r.project, l, git, st, {})
        print(f"{tag}  {dim(tr('(no new messages on {host}: keeping this one)', host=host))}")
        return
    title = tr("{title} (branch from {host})", title=BRANCH_SUFFIX.sub("", r.title), host=host)
    branch = h.branch_copy(r, l.path, fix, title)
    if l.src:  # file-based tools; opencode backs up inside its append
        backup_file(l.src, f"{l.harness}-{l.id}.jsonl")
    ack = tr("Got it: I'm taking into account what was done on {host}, and we continue from here.", host=host)
    h.append(l, _branch_summary(turns, host), ack)
    push_one(root, r.project, l, git, st, {})
    push_one(root, r.project, branch, git, st, {})
    note = tr("+ summary of what was done on {host}; its version is kept as «{title}»", host=host, title=branch.title)
    print(f"{tag}  {dim(note)}")


